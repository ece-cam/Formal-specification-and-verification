<?xml version='1.0' encoding='utf-8'?>
<launchConfiguration type="org.lamport.tla.toolbox.tool.tlc.modelCheck">
  <stringAttribute key="configurationName" value="Trucks" />
  <stringAttribute key="specName" value="trash_multiple" />
  <stringAttribute key="modelBehaviorSpec" value="Spec" />
  <stringAttribute key="modelBehaviorInit" value="" />
  <stringAttribute key="modelBehaviorNext" value="" />
  <stringAttribute key="modelComments" value="See REPORT.md for expected Users liveness counterexamples." />
  <intAttribute key="modelBehaviorSpecType" value="1" />
  <intAttribute key="numberOfWorkers" value="1" />
  <intAttribute key="fpIndex" value="0" />
  <intAttribute key="maxHeapSize" value="25" />
  <booleanAttribute key="modelCorrectnessCheckDeadlock" value="true" />
  <listAttribute key="modelParameterConstants">
    <listEntry value="NumBins;;2;0;0" />
    <listEntry value="NumUsers;;1;0;0" />
    <listEntry value="NumTrucks;;2;0;0" />
    <listEntry value="MaxCapacity;;2;0;0" />
    <listEntry value="MaxUserTrash;;1;0;0" />
  </listAttribute>
  <listAttribute key="modelCorrectnessInvariants">
    <listEntry value="1TypeOK" />
    <listEntry value="1MessagesOK" />
    <listEntry value="1CapacitiesRespected" />
    <listEntry value="1TrapNotDestroyed" />
    <listEntry value="1CapacityNotExceeded" />
    <listEntry value="1OuterDoorLocked" />
    <listEntry value="1RamOuterDoor" />
    <listEntry value="1AuthorizedOpenOnly" />
    <listEntry value="1CollectionExclusive" />
  </listAttribute>
  <listAttribute key="modelCorrectnessProperties">
    <listEntry value="1TrashEmptied" />
    <listEntry value="1UserTrash" />
    <listEntry value="1UserTrashDeposited" />
    <listEntry value="1TruckEmpties" />
